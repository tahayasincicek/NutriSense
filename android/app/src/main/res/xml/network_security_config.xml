<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release/staging/prod: platform CA store, hostname verification and TLS
         defaults. No user CA, certificate pin bypass or cleartext exception. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
