# Miscellaneous
*.class
*.log
*.pyc
**/__pycache__/
**/.pytest_cache/
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/backend/venv/
/backend/data/*.json
*.db
*.sqlite
*.sqlite3

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Secrets and platform credentials (templates remain versioned)
/backend/.env
!/backend/.env.example
**/google-services.json
**/GoogleService-Info.plist
**/*service-account*.json
**/*credentials*.json
*.jks
*.keystore

# Reproducible ML pipeline: data and generated evidence stay out of Git.
/ml/data/
/ml/runs/*
!/ml/runs/NOT_RUN/
/ml/artifacts/*
!/ml/artifacts/index.example.json
*.keras
*.h5
*.tflite
*.ckpt
