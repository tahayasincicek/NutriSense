# Miscellaneous
*.class
*.log
*.pyc
**/__pycache__/
**/.pytest_cache/
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/
**/venv/
**/.venv/
**/env/
/backend/data/*.json
/backend/.runtime/
/backend/backups/
*.db
*.sqlite
*.sqlite3

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Secrets and platform credentials (templates remain versioned)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
**/google-services.json
**/GoogleService-Info.plist
**/*service-account*.json
**/*credential*.json
**/*credentials*.json
**/firebase-adminsdk*.json
*.jks
*.keystore
/android/key.properties
/android/upload-keystore.jks
*.pem
*.key
*.p8
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
*.xcarchive/

# Database exports and operational backups
*.dump
*.bak
*.sql.gz
*.sql.bz2
*.sql.xz
*dump*.sql
*backup*.sql

# Reproducible ML pipeline: data and generated evidence stay out of Git.
/ml/data/
/ml/runs/*
!/ml/runs/NOT_RUN/
/ml/artifacts/*
!/ml/artifacts/index.example.json
# Human-participant analysis inputs and generated run artefacts.
/analysis/data/real/
/analysis/data/synthetic/*.json
/analysis/outputs/
/analysis/.venv/
/research/data/raw/
/research/exports/
/docs/research/raw/
*.keras
*.h5
*.tflite
*.ckpt
