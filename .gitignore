*backup*.sql

# Reproducible ML pipeline: data and generated evidence stay out of Git.
/ml/data/
# Deney kanitlari (metrik, karar, provenance) depoda kalir; yalniz agir
# model ikilileri disarida tutulur.
/ml/runs/*
!/ml/runs/*/
!/ml/runs/NOT_RUN/
/ml/artifacts/*
!/ml/artifacts/*/
!/ml/artifacts/index.example.json
# Human-participant analysis inputs and generated run artefacts.
/analysis/data/real/
/analysis/data/synthetic/*.json
/analysis/outputs/
/analysis/.venv/
/analysis/tools/node_modules/
/research/data/raw/
/research/exports/
/docs/research/raw/
# Completed participant/device/event evidence may contain personal data.
/delivery_evidence/voiceover_acceptance.json
/delivery_evidence/dissemination.json
/delivery_evidence/files/
*.keras
*.h5
*.tflite
*.ckpt

# Doğrulanmış dağıtım modeli uygulamayla birlikte paketlenir.
!/assets/models/*.tflite

# Egitim ciktilarinin yerel yedekleri; eski model zaten git gecmisinde duruyor.
/ml/runs_backup/
/assets/models_backup/

# Yerel cihaz kabul çıktıları ve ekran görüntüleri
/s8_*.png
/dev_found.xml
/dev_target.xml
/hw_found.xml
/_step
/wget-log
/ml_target_classes.jpg

# Yerel model araştırması, aday incelemeleri ve cihazdan alınan saha verisi
/ml/analysis/
/ml/field_data/
/ml/src/*.egg-info/

