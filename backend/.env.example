# Copy to .env. Every value marked REPLACE must come from a local secret store.
APP_NAME=NutriSense
APP_VERSION=1.0.0
APP_ENVIRONMENT=dev
DEBUG=false
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_APPLICATION_SECRET

# DATABASE_URL is canonical. Split DB_* values are Compose interpolation only.
DATABASE_URL=mysql+pymysql://nutrisense:REPLACE_DB_PASSWORD@localhost:3306/nutrisense_db?charset=utf8mb4
DB_HOST=localhost
DB_PORT=3306
DB_USER=nutrisense
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
DB_NAME=nutrisense_db
TEST_DB_NAME=nutrisense_test

JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
RESEARCH_EXPORT_TOKEN=REPLACE_WITH_LONG_RANDOM_RESEARCH_EXPORT_TOKEN
MIGRATION_CHECK_ENABLED=true

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Local Compose development uses Mailpit at mailpit:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=NutriSense
SMTP_FROM_EMAIL=noreply@nutrisense.invalid
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
