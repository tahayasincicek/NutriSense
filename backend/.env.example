# Copy to .env. Every value marked REPLACE must come from a local secret store.
APP_NAME=NutriSense
APP_VERSION=1.0.0
APP_ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_APPLICATION_SECRET
PUBLIC_BASE_URL=http://localhost:8000
API_DOCS_ENABLED=true
BUILD_REVISION=local
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
# verify | apply | skip. staging/prod application container must use verify.
MIGRATION_STARTUP_MODE=verify
# Only for localhost staging-like Compose; never true on an external staging host.
STAGING_ALLOW_INSECURE_LOCALHOST=false

# DATABASE_URL is canonical. Split DB_* values are Compose interpolation only.
DATABASE_URL=mysql+pymysql://nutrisense:REPLACE_DB_PASSWORD@localhost:3306/nutrisense_db?charset=utf8mb4
DB_HOST=localhost
DB_PORT=3306
DB_USER=nutrisense
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
DB_NAME=nutrisense_db
TEST_DB_NAME=nutrisense_test

JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=nutrisense-api
JWT_AUDIENCE=nutrisense-mobile
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
RESEARCH_EXPORT_TOKEN=REPLACE_WITH_LONG_RANDOM_RESEARCH_EXPORT_TOKEN
RESEARCH_PSEUDONYMIZATION_KEY=REPLACE_WITH_LONG_RANDOM_RESEARCH_PSEUDONYMIZATION_KEY
# disabled | synthetic | approved. Gerçek katılımcı için yalnız approved kullanılır.
RESEARCH_MODE=synthetic
# Aşağıdaki alanları yalnız etik kurul kararı çıktıktan sonra gerçek değerlerle doldurun.
RESEARCH_PROTOCOL_VERSION=
RESEARCH_CONSENT_VERSION=
RESEARCH_APPROVAL_REFERENCE=
# Sadece kurul kararı açıkça ses kaydına izin veriyorsa true yapılabilir.
RESEARCH_AUDIO_CONSENT_APPROVED=false
MIGRATION_CHECK_ENABLED=true

# KVKK veri sorumlusu ve ilgili kişi başvuru kanalı. Kurum kararıyla
# doldurulmadan production başlamaz; /hesap-silme ve /kvkk-basvuru
# sayfalarında gösterilir.
PRIVACY_NOTICE_VERSION=taslak-yayinlanmadi
DATA_CONTROLLER_NAME=
DATA_CONTROLLER_CONTACT_EMAIL=
DATA_CONTROLLER_POSTAL_ADDRESS=
# Gemini/Google Vision, Nutritionix, Twilio veya production SMTP etkinse
# KVKK m.9 aktarım değerlendirmesinin kayıt numarası (production'da zorunlu).
CROSS_BORDER_TRANSFER_REFERENCE=

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=
# disabled | google | gemini
VISION_PROVIDER_MODE=disabled
# VISION_PROVIDER_MODE=gemini icin gerekli (Google AI Studio API anahtari)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Ücretsiz katman içeriği ürün geliştirmede kullanabilir; production'da
# yalnız faturalandırmalı Gemini projesi kabul edilir.
GEMINI_PAID_TIER_CONFIRMED=false
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=
# disabled | verified_local | nutritionix | hybrid
NUTRITION_PROVIDER_MODE=verified_local
# Varsayılan: app/data/verified_nutrition.json (kaynak doğrulamalı USDA alt kümesi).
# CALORIE_DB_PATH yalnız aynı kayıt doğrulama kurallarını sağlayan özel katalog için kullanılmalıdır.
# disabled | twilio | local_outbox
# local_outbox gercek operatore cikmaz; mesaji SMS_OUTBOX_PATH dosyasina yazar.
SMS_PROVIDER_MODE=disabled
SMS_OUTBOX_PATH=.runtime/sms_outbox.jsonl

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# disabled | sandbox | production. Sandbox yalnız aşağıdaki allowlist'e gönderir.
NOTIFICATION_MODE=sandbox
NOTIFICATION_SANDBOX_EMAIL_ALLOWLIST=sandbox-dietitian@nutrisense.invalid
NOTIFICATION_SANDBOX_PHONE_ALLOWLIST=+15005550006

# Local Compose development uses Mailpit at mailpit:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=NutriSense
SMTP_FROM_EMAIL=noreply@nutrisense.invalid
SMTP_USE_TLS=false
SMTP_START_TLS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
SECURITY_HSTS_MAX_AGE_SECONDS=31536000

# Internal operations endpoint. Never expose its token to the mobile binary.
METRICS_ENABLED=false
OPERATIONS_TOKEN=REPLACE_WITH_LONG_RANDOM_OPERATIONS_TOKEN

# Model fetching is a separate checksum-gated job; application startup never
# downloads or fabricates a model.
ML_ARTIFACT_ENABLED=false
ML_ARTIFACT_PATH=
ML_ARTIFACT_SHA256=
